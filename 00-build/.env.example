# Copy to .env and fill in. .env is gitignored, never commit secrets.

# Model provider: Anthropic Claude via the Claude Agent SDK. No API key needed:
# Cortex uses the Claude subscription login on this machine (`claude auth login`).

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=claude-opus-5-5        # drafter; claude-haiku-5-5 for a lighter, cheaper run
CORTEX_CRITIC_MODEL=claude-opus-5-5 # validator model (defaults to CORTEX_MODEL)
CORTEX_MAX_ITERATIONS=8       # loop cap: max model turns per run, then stop + escalate
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.50      # spend cap per run (SDK cost estimate), enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run
CORTEX_MAX_TOOL_ERRORS=3      # stuck exit: same data source errors this many times -> halt

# Demo only: make tools return "access denied" (comma-separated names, or "all").
# Leave empty for normal runs. e.g. CORTEX_SIMULATE_OUTAGE=get_activity
CORTEX_SIMULATE_OUTAGE=

# Demo only (M3): write a fault into each finished draft so the critic rejects it.
# invent_metric, commit_date, or both comma-separated. Leave empty for normal runs.
CORTEX_DEMO_FAULT=
